<Window x:Class="flapping_penguin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:flapping_penguin"
        mc:Ignorable="d"
        Title="MainWindow"
        Height="150" Width="150"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- リーダーが用意してくれた画像とアニメーション用のパーツ（そのまま残しています！） -->
            <Image x:Name="CatImage" Width="150" Height="150" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <ScaleTransform x:Name="CatImageScale" ScaleX="1" ScaleY="1" />
                </Image.RenderTransform>
            </Image>
        </StackPanel>

        <Popup x:Name="SpeechPopup" 
               PlacementTarget="{Binding ElementName=CatImage}" 
               Placement="Top" 
               VerticalOffset="-10" 
               AllowsTransparency="True" 
               IsOpen="False">
            <Border Background="White" BorderBrush="#333333" BorderThickness="2" CornerRadius="10" Padding="15,10">
                <TextBlock x:Name="SpeechText" Text="セリフ" FontSize="14" FontWeight="Bold" Foreground="#333333" />
            </Border>
        </Popup>
    </Grid>
</Window>