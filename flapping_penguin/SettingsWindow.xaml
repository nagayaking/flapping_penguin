<Window x:Class="flapping_penguin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="260" Width="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <!-- 移動のオンオフ -->
        <CheckBox x:Name="MovementToggle" Content="移動を有効にする" />

        <TextBlock Text="移動スピード:" Margin="0,20,0,5" />

        <!-- スピード調整用スライダー。IsEnabledで上のチェックボックスと連動してロック状態を切り替えます -->
        <Slider x:Name="SpeedSlider" Minimum="1" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                IsEnabled="{Binding IsChecked, ElementName=MovementToggle}" />

        <!-- 現在のスライダーの数値を右下に表示 -->
        <TextBlock Text="{Binding Value, ElementName=SpeedSlider}" HorizontalAlignment="Right" />

        <Button Content="保存して閉じる" Width="100" Margin="0,20,0,0" Click="SaveButton_Click" />
        <Button x:Name="ExitButton" Content="アプリを終了する" Height="30" Margin="20" Width="150" Click="ExitButton_Click" />
    </StackPanel>
</Window>