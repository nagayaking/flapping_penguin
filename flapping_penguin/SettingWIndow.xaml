<Window x:Class="flapping_penguin.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Height="200" Width="300" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">

        <!-- 移動のオンオフを切り替えるチェックボックス -->
        <CheckBox x:Name="MovementToggle" Content="移動を有効にする" IsChecked="True" />

        <TextBlock Text="移動スピード:" Margin="0,20,0,5" />

        <!-- スピード調整用スライダー。IsEnabledを上のチェックボックスと連動させています -->
        <Slider x:Name="SpeedSlider" Minimum="5" Maximum="100" Value="30" 
                TickFrequency="5" IsSnapToTickEnabled="True"
                IsEnabled="{Binding IsChecked, ElementName=MovementToggle}" />

        <!-- 現在のスピードの数値を表示 -->
        <TextBlock Text="{Binding Value, ElementName=SpeedSlider}" HorizontalAlignment="Right" />

        <Button Content="閉じる" Width="100" Margin="0,20,0,0" Click="CloseButton_Click" />
    </StackPanel>
</Window>